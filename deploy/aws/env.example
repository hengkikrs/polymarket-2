# Copy to /opt/poly-v3/.env on the EC2 instance and fill real values there.
# Never commit real Polymarket keys.

POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1

MOCK_MODE=true
LIVE_TRADING_CONFIRM=

STRATEGY_MODE=END_WINDOW
END_WINDOW_ENABLED=true
TRADE_AMOUNT=100.00
END_WINDOW_TRADE_USD=100.00
END_WINDOW_LIVE_TRADE_USD=1.00
END_WINDOW_MIN_TRADE_USD=100.00
END_WINDOW_MAX_TRADES_PER_WINDOW=9

DASH_HOST=127.0.0.1
DASH_PORT=5004
LOG_LEVEL=INFO

CLOB_CACHE_MAX_AGE_SECS=0.75
CLOB_POLL_TARGET_RPM=1200
CLOB_POLL_MIN_SWEEP_INTERVAL=0.10
CLOB_POLL_MAX_CONCURRENCY=4
CLOB_BOOK_TIMEOUT_SECS=0.75
END_WINDOW_DIRECT_BOOK_TIMEOUT_SECS=0.12
END_WINDOW_DIRECT_BOOK_CACHE_MAX_AGE_SECS=1.0

